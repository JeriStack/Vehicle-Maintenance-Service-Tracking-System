{
    "name": "vms/vehicle-maintenance-tracking-system",
    "description": "Vehicle Maintenance Service Tracking System",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5 || ^10.0 || ^11.0"
    },
    "autoload": {
        "psr-4": {
            "VMS\\": "app/",
            "Database\\Seeders\\": "database/seeders/"
        },
        "files": [
            "app/Support/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "php tests/run_tests.php",
        "test:smoke": "php tests/run_tests.php --smoke",
        "test:db": "php tests/run_tests.php --database",
        "test:all": "php tests/run_tests.php --all"
    }
}
