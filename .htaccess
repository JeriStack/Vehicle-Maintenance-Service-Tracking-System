# Disable directory browsing
Options -Indexes

# Protect dotfiles (.env, .git, .htaccess, etc.)
<FilesMatch "^\.">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Protect non-public configuration, metadata, log, script, and SQL files
<FilesMatch "\.(ini|log|sql|json|lock|md|sh|bat|bak|puml|xml|yml|yaml|dist|env|txt)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Security Headers (if mod_headers is enabled)
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-XSS-Protection "1; mode=block"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Handle errors gracefully
ErrorDocument 403 /Vehicle-Maintenance-Service-Tracking-System/index.php
ErrorDocument 404 /Vehicle-Maintenance-Service-Tracking-System/index.php

# Basic Rewrite (if needed for nice URLs later)
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    # Uncomment if using router: RewriteRule ^(.*)$ index.php?url=$1 [QSA,L]
</IfModule>
