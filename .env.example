# Application Configuration
APP_NAME="Vehicle Maintenance Service Tracking System"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost/Vehicle-Maintenance-Service-Tracking-System/public
APP_TIMEZONE=Asia/Manila

# Logging Configuration
LOG_LEVEL=debug
LOG_PATH=storage/logs/app.log

# Database Configuration (MySQL / MariaDB via PDO)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=vehicle_maintenance_db
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4

# Session Configuration
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_SECURE=false

# Real-Time WebSocket Daemon
WEBSOCKET_ENABLED=true
WEBSOCKET_HOST=127.0.0.1
WEBSOCKET_PORT=8080

# Mail Configuration (Supports 'log' or 'smtp')
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=noreply@vms.local
MAIL_FROM_NAME="VMS Tracker"
